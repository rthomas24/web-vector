{
  "name": "webvector-mcp",
  "version": "0.1.0",
  "description": "MCP server for WebVector: web_research (search → read full pages → rank → cited passages), web_fetch, web_search. Zero-config `npx -y webvector-mcp` (~12 MB, lexical); add @huggingface/transformers or an API key for semantic search.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "web-research",
    "rag",
    "claude",
    "cursor",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rthomas24/web-vector",
    "directory": "packages/mcp"
  },
  "bin": {
    "webvector-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "webvector": "^0.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "author": "Ryan Thomas",
  "homepage": "https://github.com/rthomas24/web-vector#readme",
  "bugs": {
    "url": "https://github.com/rthomas24/web-vector/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
