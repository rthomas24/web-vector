{
  "name": "webvector",
  "version": "0.1.0",
  "description": "Provider-agnostic web research for AI agents: search → full-page ingestion → embeddings → semantic retrieval → cited passages. One tool call.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "ai",
    "agents",
    "web-search",
    "rag",
    "embeddings",
    "vector",
    "retrieval",
    "mcp",
    "tool",
    "readability",
    "duckduckgo",
    "brave",
    "openai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rthomas24/web-vector",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "default": "./dist/stores/index.js"
    },
    "./rerankers": {
      "types": "./dist/rerankers/index.d.ts",
      "default": "./dist/rerankers/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "default": "./dist/ingest/index.js"
    },
    "./retrieval": {
      "types": "./dist/retrieval/index.d.ts",
      "default": "./dist/retrieval/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "default": "./dist/integrations/ai-sdk.js"
    },
    "./anthropic": {
      "types": "./dist/integrations/anthropic.d.ts",
      "default": "./dist/integrations/anthropic.js"
    },
    "./openai": {
      "types": "./dist/integrations/openai.d.ts",
      "default": "./dist/integrations/openai.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "default": "./dist/integrations/langchain.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/core"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "encoding-sniffer": "^1.0.2",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "mdream": "^1.6.3",
    "robots-parser": "^3.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "ai": "^7.0.0",
    "chromadb": "^3.0.0",
    "defuddle": "^0.19.0",
    "gpt-tokenizer": "^3.0.0 || ^4.0.0",
    "pg": "^8.0.0",
    "pgvector": "^0.3.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@qdrant/js-client-rest": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "chromadb": {
      "optional": true
    },
    "defuddle": {
      "optional": true
    },
    "gpt-tokenizer": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@types/pg": "^8.15.0",
    "ai": "^7.0.66",
    "chromadb": "^3.5.0",
    "gpt-tokenizer": "^4.0.0",
    "msw": "^2.15.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "yaml": "^2.9.0"
  },
  "author": "Ryan Thomas",
  "homepage": "https://github.com/rthomas24/web-vector#readme",
  "bugs": {
    "url": "https://github.com/rthomas24/web-vector/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
